# Names only. Values are never committed (.planning/03 §7, R-C6).

# --- apps/web-astro (server side only) ---
# Runtime value read with process.env, never import.meta.env (O-11): a build must not bake it.
PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
# live  -> call PUBLIC_API_BASE_URL
# mock  -> serve the contract-first dummy dataset (no API needed, P6 only)
# absent -> mock when PUBLIC_API_BASE_URL is unset, live otherwise
API_MODE=mock
LOG_LEVEL=info

# --- apps/api (Iqram, P5) ---
API_PORT=3001
DATABASE_URL=postgres://app:app@localhost:5432/taskapp
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=taskapp
SESSION_COOKIE_NAME=sid
SESSION_TTL_DAYS=7
APP_ORIGIN=http://localhost:4321
UPLOAD_ROOT=./storage
UPLOAD_MAX_BYTES=5242880
