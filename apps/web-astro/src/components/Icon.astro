---
/**
 * One icon set for both frontends (design/05 §4). The sprite lives in /icons.svg and every glyph
 * is a stroke path on `currentColor`, so colour comes from the surrounding token.
 */
interface Props {
  name:
    | 'task'
    | 'note'
    | 'image'
    | 'search'
    | 'pin'
    | 'plus'
    | 'trash'
    | 'chevron-down'
    | 'arrow-left'
    | 'arrow-right'
    | 'close'
    | 'calendar'
    | 'logout'
    | 'menu'
    | 'alert';
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = 'icon' } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  aria-hidden="true"
  focusable="false"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <use href={`/icons.svg#i-${name}`}></use>
</svg>
