{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rweb-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-01",
	"observability": {
		"enabled": true
	},
	"vars": {
		"ENVIRONMENT": "development",
		"APP_ORIGIN": "http://localhost:4321",
		"SESSION_TTL_DAYS": "7",
		"SESSION_IDLE_HOURS": "24",
		"SESSION_REFRESH_MINUTES": "60"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rweb-auth",
			"database_id": "dd5e279a-04fd-466c-a9ca-9acada0e09bc",
			"migrations_dir": "migrations"
		}
	],
	// Attachment binaries (06 §8, 07 §1.2 B5). Keys are `<user_id>/<attachment_id>.<ext>`; nothing
	// is ever served from the bucket directly — every read goes through the authenticated route.
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "rweb-attachments"
		}
	],
	// T-511: session purge and the orphan-object sweep. Daily, off-peak.
	"triggers": {
		"crons": ["17 3 * * *"]
	},
	"env": {
		"production": {
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "rweb-auth",
					"database_id": "dd5e279a-04fd-466c-a9ca-9acada0e09bc",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "BUCKET",
					"bucket_name": "rweb-attachments"
				}
			],
			"triggers": {
				"crons": ["17 3 * * *"]
			},
			"vars": {
				"ENVIRONMENT": "production",
				"APP_ORIGIN": "https://web-astro.wanaask.workers.dev",
				"APP_ORIGIN_NEXT": "https://web-next.wanaask.workers.dev",
				"SESSION_TTL_DAYS": "7",
				"SESSION_IDLE_HOURS": "24",
				"SESSION_REFRESH_MINUTES": "60"
			}
		}
	}
}