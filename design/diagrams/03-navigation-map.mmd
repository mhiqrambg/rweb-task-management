  Gate -->|"no or expired or idle-revoked sid, 302 /login?next=current-path"| Login
  Dashboard -->|"sidebar"| TaskList
  Dashboard -->|"sidebar"| NoteList
  Dashboard -->|"user menu"| Account
  Dashboard -.->|"401 mid-session, redirect to /login?next=current-path"| Gate
  TaskList --> TaskDetail
  TaskList -->|"create, modal on the list"| TaskEdit
  TaskDetail --> TaskEdit
  TaskDetail -.->|"unknown or foreign id"| NotFound
  NoteList --> NoteDetail
  NoteDetail -.->|"unknown or foreign id"| NotFound
  PublicNote -.->|"unknown public path"| Public404

