flowchart LR
  Visitor(["Visitor"])
  Member(["Member - owner"])
  Browser["Browser<br>one origin"]
  Harness["Benchmark harness<br>Playwright + Lighthouse"]

  subgraph Boundary["System boundary - one host (Docker Compose)"]
    Astro["apps/web-astro<br>Astro - on-demand SSR"]
    Next["apps/web-next<br>Next - static export under /b"]
    Api["apps/api<br>Elysia - REST /api/v1"]
    Pg[("Cloudflare D1<br>SQLite · Serverless Database")]
    Storage[("Upload storage<br>R2 bucket")]
  end

  Proxy["Reverse proxy (nginx)<br>one origin, terminates TLS<br>refuses /uploads/*"]
  Outside["Outside the boundary<br>no email transport, no object storage, no CDN, no analytics"]

  Visitor --> Browser
  Member --> Browser
  Browser -->|"HTTPS 443, sid cookie"| Proxy
  Harness -->|"HTTPS page loads and /api/v1/health"| Proxy
  Proxy -->|"HTTP / and /login and /register and /app and /tasks and /notes and /account"| Astro
  Proxy -->|"static files /b/*"| Next
  Proxy -->|"HTTP /api/v1/*"| Api
  Astro -->|"server-side fetch, Cookie header forwarded"| Api
  Api -->|"pg wire protocol 5432"| Pg
  Api -->|"read and write binaries and thumbnails"| Storage

