        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="05 — Request authorization, multipart upload, thumbnail, lightbox read" style="text;html=1;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#1B1F24;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="900" height="30" as="geometry"/></mxCell>
