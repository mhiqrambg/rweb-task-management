        <mxCell id="lif_p" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#B8C0CC;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="110" as="sourcePoint"/><mxPoint x="460" y="1250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lif_a" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#B8C0CC;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="110" as="sourcePoint"/><mxPoint x="760" y="1250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lif_d" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#B8C0CC;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200" y="110" as="sourcePoint"/><mxPoint x="1200" y="1250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="lif_s" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#B8C0CC;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1440" y="110" as="sourcePoint"/><mxPoint x="1440" y="1250" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="pb" value="Browser" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="pp" value="Reverse proxy" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350" y="60" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="pa" value="apps/api" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#9DB8F2;fontColor=#1B1F24;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="650" y="60" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="pd" value="PostgreSQL" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1090" y="60" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="ps" value="Upload storage" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F3EEFF;strokeColor=#B9A6F0;fontColor=#1B1F24;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1330" y="60" width="220" height="50" as="geometry"/></mxCell>
        <mxCell id="band_a" value="Flow A — authorized read of an owned Attachment (lightbox uses variant=full)" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=10;fillColor=#F2F4F7;strokeColor=#B8C0CC;fontColor=#1B1F24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="140" width="550" height="30" as="geometry"/></mxCell>
        <mxCell id="m1" value="GET /api/v1/attachments/:id/content&lt;br&gt;variant=full, sid cookie" style="html=1;whiteSpace=wrap;fontSize=11;fontColor=#46505C;labelBackgroundColor=#FFFFFF;strokeColor=#8A94A6;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="195" as="sourcePoint"/><mxPoint x="460" y="195" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m2" value="forward on one origin, no authorization decision" style="html=1;whiteSpace=wrap;fontSize=11;fontColor=#46505C;labelBackgroundColor=#FFFFFF;strokeColor=#8A94A6;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="235" as="sourcePoint"/><mxPoint x="760" y="235" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="self1" value="read sid, SHA-256 it, check Origin on unsafe methods only" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF0E5;strokeColor=#F0B48A;fontColor=#1B1F24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="258" width="195" height="36" as="geometry"/></mxCell>
        <mxCell id="s1" value="" style="html=1;strokeColor=#8A94A6;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="276" as="sourcePoint"/><mxPoint x="880" y="276" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m3" value="SELECT session JOIN users by token_hash, expires_at, last_used_at" style="html=1;whiteSpace=wrap;fontSize=11;fontColor=#46505C;labelBackgroundColor=#FFFFFF;strokeColor=#8A94A6;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="320" as="sourcePoint"/><mxPoint x="1200" y="320" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m4" value="401 UNAUTHENTICATED with expired Set-Cookie" style="html=1;whiteSpace=wrap;fontSize=11;fontColor=#46505C;labelBackgroundColor=#FFFFFF;strokeColor=#8A94A6;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="360" as="sourcePoint"/><mxPoint x="130" y="360" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m5" value="SELECT attachment WHERE id = $1 AND user_id = $sessionUserId" style="html=1;whiteSpace=wrap;fontSize=11;fontColor=#46505C;labelBackgroundColor=#FFFFFF;strokeColor=#8A94A6;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="400" as="sourcePoint"/><mxPoint x="1200" y="400" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m6" value="404 NOT_FOUND — absent and foreign are indistinguishable" style="html=1;whiteSpace=wrap;fontSize=11;fontColor=#46505C;labelBackgroundColor=#FFFFFF;strokeColor=#8A94A6;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="440" as="sourcePoint"/><mxPoint x="130" y="440" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m7" value="open storage_key for variant full or thumb" style="html=1;whiteSpace=wrap;fontSize=11;fontColor=#46505C;labelBackgroundColor=#FFFFFF;strokeColor=#8A94A6;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="480" as="sourcePoint"/><mxPoint x="1440" y="480" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m8" value="200 bytes with ETag, private max-age 86400, nosniff&lt;br&gt;304 when If-None-Match matches" style="html=1;whiteSpace=wrap;fontSize=11;fontColor=#46505C;labelBackgroundColor=#FFFFFF;strokeColor=#8A94A6;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="520" as="sourcePoint"/><mxPoint x="130" y="520" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="note_a" value="The row is the authorization authority: ownership is checked before any file is opened." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=10;fillColor=#F2F4F7;strokeColor=#B8C0CC;fontColor=#1B1F24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="555" width="550" height="40" as="geometry"/></mxCell>
        <mxCell id="band_b" value="Flow B — multipart upload, two-gate validation, thumbnail" style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=10;fillColor=#F2F4F7;strokeColor=#B8C0CC;fontColor=#1B1F24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="620" width="550" height="30" as="geometry"/></mxCell>
        <mxCell id="m9" value="POST /api/v1/attachments multipart&lt;br&gt;file, targetType, targetId" style="html=1;whiteSpace=wrap;fontSize=11;fontColor=#46505C;labelBackgroundColor=#FFFFFF;strokeColor=#8A94A6;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="130" y="675" as="sourcePoint"/><mxPoint x="460" y="675" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m10" value="forward" style="html=1;whiteSpace=wrap;fontSize=11;fontColor=#46505C;labelBackgroundColor=#FFFFFF;strokeColor=#8A94A6;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="460" y="715" as="sourcePoint"/><mxPoint x="760" y="715" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="self2" value="exactly one file part, file under 5 MiB, else 413 or 422" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF0E5;strokeColor=#F0B48A;fontColor=#1B1F24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="738" width="195" height="36" as="geometry"/></mxCell>
        <mxCell id="s2" value="" style="html=1;strokeColor=#8A94A6;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="756" as="sourcePoint"/><mxPoint x="880" y="756" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m11" value="SELECT target WHERE id = $targetId AND user_id = $sessionUserId" style="html=1;whiteSpace=wrap;fontSize=11;fontColor=#46505C;labelBackgroundColor=#FFFFFF;strokeColor=#8A94A6;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="800" as="sourcePoint"/><mxPoint x="1200" y="800" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m12" value="404 NOT_FOUND, nothing written" style="html=1;whiteSpace=wrap;fontSize=11;fontColor=#46505C;labelBackgroundColor=#FFFFFF;strokeColor=#8A94A6;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="840" as="sourcePoint"/><mxPoint x="130" y="840" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="self3" value="gate 1 sniff magic bytes in image/jpeg, image/png, image/webp, else 415" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF0E5;strokeColor=#F0B48A;fontColor=#1B1F24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="862" width="195" height="52" as="geometry"/></mxCell>
        <mxCell id="s3" value="" style="html=1;strokeColor=#8A94A6;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="888" as="sourcePoint"/><mxPoint x="880" y="888" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="self4" value="gate 2 sharp decode metadata, else 422 undecodable_image" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF0E5;strokeColor=#F0B48A;fontColor=#1B1F24;fontSize=11;" vertex="1" parent="1"><mxGeometry x="880" y="926" width="195" height="36" as="geometry"/></mxCell>
        <mxCell id="s4" value="" style="html=1;strokeColor=#8A94A6;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="944" as="sourcePoint"/><mxPoint x="880" y="944" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m13" value="write full file via temp then rename" style="html=1;whiteSpace=wrap;fontSize=11;fontColor=#46505C;labelBackgroundColor=#FFFFFF;strokeColor=#8A94A6;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="985" as="sourcePoint"/><mxPoint x="1440" y="985" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m14" value="derive thumbnail, longest edge 320 px, WebP" style="html=1;whiteSpace=wrap;fontSize=11;fontColor=#46505C;labelBackgroundColor=#FFFFFF;strokeColor=#8A94A6;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="1025" as="sourcePoint"/><mxPoint x="1440" y="1025" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m15" value="BEGIN, parent row FOR UPDATE, count existing rows" style="html=1;whiteSpace=wrap;fontSize=11;fontColor=#46505C;labelBackgroundColor=#FFFFFF;strokeColor=#8A94A6;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="1065" as="sourcePoint"/><mxPoint x="1200" y="1065" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m16" value="unlink full file and thumbnail" style="html=1;whiteSpace=wrap;fontSize=11;fontColor=#46505C;labelBackgroundColor=#FFFFFF;strokeColor=#8A94A6;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="1105" as="sourcePoint"/><mxPoint x="1440" y="1105" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m17" value="422 attachment_limit" style="html=1;whiteSpace=wrap;fontSize=11;fontColor=#46505C;labelBackgroundColor=#FFFFFF;strokeColor=#8A94A6;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="1135" as="sourcePoint"/><mxPoint x="130" y="1135" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m18" value="INSERT attachments, COMMIT" style="html=1;whiteSpace=wrap;fontSize=11;fontColor=#46505C;labelBackgroundColor=#FFFFFF;strokeColor=#8A94A6;verticalAlign=bottom;endArrow=block;endFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="1175" as="sourcePoint"/><mxPoint x="1200" y="1175" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m19" value="201 Created with AttachmentSummary thumbUrl and fullUrl" style="html=1;whiteSpace=wrap;fontSize=11;fontColor=#46505C;labelBackgroundColor=#FFFFFF;strokeColor=#8A94A6;verticalAlign=bottom;endArrow=block;endFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="760" y="1215" as="sourcePoint"/><mxPoint x="130" y="1215" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="note_b" value="The row is the commit point — no row ever points at a missing binary (NFR-REL-003)." style="shape=note;whiteSpace=wrap;html=1;size=12;align=left;spacingLeft=10;fillColor=#F2F4F7;strokeColor=#B8C0CC;fontColor=#1B1F24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="1252" width="680" height="34" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
