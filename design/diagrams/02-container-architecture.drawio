        <mxCell id="proxy" value="Reverse proxy (nginx) — one origin, terminates TLS&lt;br&gt;routes / and form posts to web-astro, /b/* to the static export, /api/v1/* to apps/api&lt;br&gt;refuses /uploads/*" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#B8C0CC;fontColor=#1B1F24;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="180" width="1060" height="80" as="geometry"/></mxCell>
